# --- Database (libSQL/SQLite) ---
# Local sqld service (docker compose): http://localhost:8080
# Or a plain local SQLite file: file:./payload.db
DATABASE_URL=http://localhost:8080
DATABASE_AUTH_TOKEN=

# --- Payload ---
PAYLOAD_SECRET=c5bf791df2628d547423d6a24d7ac888756500ebc83e6392a97730afadb6331a

# --- Object storage (S3-protocol: MinIO locally, R2 in prod) ---
# Matches docker-compose.yml minio service (S3 API on localhost:9100,
# bucket "fotopick", creds fotopick/fotopick-local-dev, public read).
STORAGE_BUCKET=fotopick
STORAGE_REGION=auto
STORAGE_ENDPOINT=http://localhost:9100
STORAGE_ACCESS_KEY_ID=fotopick
STORAGE_SECRET_ACCESS_KEY=fotopick-local-dev
STORAGE_PUBLIC_URL_BASE=http://localhost:9100/fotopick
STORAGE_FORCE_PATH_STYLE=true

# --- Admin panel auth ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_SESSION_SECRET=81552447dbe8bc1e3cfe50b67d495f6d5ce02d7e1816379f083f56c59e3fef21

