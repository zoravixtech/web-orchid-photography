# Local file: DATABASE_URL=file:./payload.db
# Docker (libsql service): DATABASE_URL=http://libsql:8080
DATABASE_URL=file:./payload.db
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Cloudflare R2 (prod) / MinIO (docker dev — matches docker-compose.yml minio service)
R2_BUCKET=dev-bucket
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_ENDPOINT=http://minio:9000
